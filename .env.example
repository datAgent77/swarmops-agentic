# SwarmOps — environment template. Copy to .env and fill in as needed.
# P00 ships placeholders only; later phases consume the Google Cloud values.

# --- Core ---------------------------------------------------------------
ENVIRONMENT=development
DEMO_MODE=true

# Comma-separated list of allowed frontend origins for the API (CORS).
CORS_ORIGINS=http://localhost:3000

# --- Persistence & eventing (P12) ---------------------------------------
# PERSISTENCE_BACKEND: "local" (SQLite, default) or "firestore" (needs [gcp] extra).
PERSISTENCE_BACKEND=local
SQLITE_PATH=swarmops.db
# EVENT_BUS: "inmemory" (default) or "pubsub" (needs a GCP project + [gcp] extra).
EVENT_BUS=inmemory

# --- Frontend -----------------------------------------------------------
# Base URL the web app uses to reach the backend.
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Google Cloud / Gemini (wired in later phases; leave blank for local) --
GOOGLE_CLOUD_PROJECT=
# For Gemini 3.5 via Vertex AI, use the global endpoint (regional endpoints may not
# have the 3.5 models yet): GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_LOCATION=us-central1
# When true, the GenAI SDK/ADK route calls through Vertex AI instead of the
# Gemini Developer API.
GOOGLE_GENAI_USE_VERTEXAI=false
GEMINI_MODEL=gemini-3.5-flash
# Direct Gemini Developer API key (alternative to Vertex AI). Leave blank to use the
# local-template fallback for the GovernanceAgent (P07).
GEMINI_API_KEY=

# --- Observability (P09) ------------------------------------------------
# When true with a GCP project, traces export to Cloud Trace; otherwise the audit
# trail retains local, trace-correlated telemetry.
OTEL_ENABLED=false

# --- Security (P10) -----------------------------------------------------
# When true with a GCP project AND google-cloud-modelarmor installed, scanning uses
# Google Model Armor (shown as LIVE); otherwise the local demo scanner (LOCAL DEMO).
MODEL_ARMOR_ENABLED=false
